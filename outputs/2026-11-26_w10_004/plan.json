  "q5_go": "さあ、5問目。どうぞ。",
  "q5_ans1": "ひだりの、かごの、りんごが、ひとつ、へりました。",
  "q5_ans2": "みぎうえの、うえきばちが、あおく、なりました。",
  "q5_ans3": "みぎの、かばんが、リュックに、かわりました。",
  "q6_card": "6問目、しょきゅう。さかなやの、だいです。",
  "q6_go": "ゆっくり、6問目。どうぞ。",
  "q7_card": "7問目、ちゅうきゅう。かいさつの、まえです。",
  "q7_go": "もうすこしです。7問目、どうぞ。",
  "q7_ans1": "ひだりの、きゅうすが、はんたいむきに、なりました。",
  "q7_ans2": "みぎうえの、ランプが、なくなりました。",
  "q7_ans3": "したの、にもつの、ひもが、あかく、なりました。",
  "q8_card": "8問目、ちゅうきゅう。さかなやの、のきさきです。",
  "q8_go": "では、8問目。どうぞ。",
  "q9_card": "9問目、じょうきゅう。ゆきのホームと、れっしゃです。",
  "q9_go": "つぎは、9問目です。どうぞ。",
  "q9_ans1": "しょうめんの、ひょうじが、きいろく、なりました。",
  "q9_ans2": "はしらに、スコップが、いっぽん、ふえました。",
  "q9_ans3": "まえの、れんけつきが、あかく、なりました。",
  "q10_card": "10問目、じょうきゅう。ふゆの、しょうてんがいの、とおりです。",
  "q10_go": "10問目も、みっつ、さがしてください。どうぞ。",
  "op": "ふゆの、まちがいさがし、10問。",
  "op2": "だんだん、むずかしくなります。",
  "u1": "ここでひとやすみ。こよみせんせいの、きせつのおはなしです。",
